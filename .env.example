# PostgreSQL connection string (docker-compose default below)
DATABASE_URL=postgresql://prediction:prediction@localhost:5432/prediction?schema=public

# Secret used to sign admin session cookies. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Public base URL embedded in QR codes (no trailing slash)
APP_URL=http://localhost:3000

# Timezone used for admin displays, exports and WhatsApp timestamps (IANA name)
APP_TIMEZONE=Asia/Kolkata

# Country code prefixed to 10-digit mobile numbers entered without one (digits only, no +)
DEFAULT_COUNTRY_CODE=91

# Seed admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@greenjobs.com
SEED_ADMIN_PASSWORD=change-me-before-deploy
SEED_ADMIN_NAME=Green Jobs Admin

# WhatsApp Business Cloud API (Meta). Leave DRY_RUN=true to log messages instead of sending.
WHATSAPP_DRY_RUN=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Names of the approved templates in Meta Business Manager (see README for the parameter order)
WHATSAPP_TEMPLATE_SUBMITTED=prediction_submitted
WHATSAPP_TEMPLATE_WINNER=prediction_winner
WHATSAPP_TEMPLATE_WINNER_DRAW=prediction_winner_draw
WHATSAPP_TEMPLATE_LOST=prediction_lost
WHATSAPP_TEMPLATE_SCORE_WINNER=score_winner
WHATSAPP_TEMPLATE_RESULT=result_announcement

# Only needed if you drain the notification queue via POST /api/jobs/notifications instead of `npm run worker`
CRON_SECRET=

# Reserved for a future football data provider
FOOTBALL_API_KEY=

# Event sponsor shown on the participant page, result screens and QR poster (leave SPONSOR_NAME empty to hide)
SPONSOR_NAME=Green Jobs
SPONSOR_TAGLINE=Presented by
SPONSOR_LOGO_URL=/sponsors/green-jobs.jpg
SPONSOR_URL=

# Admin profile icon shown in the console (file in public/avatars or an https URL; empty = letter avatar)
ADMIN_AVATAR_URL=/avatars/admin.svg
